menu "Factory timer configuration"

config FACTORY_WIFI_SSID
    string "Wi-Fi SSID"
    default ""
    help
        SSID used by this timer in Wi-Fi station mode.

config FACTORY_WIFI_PASSWORD
    string "Wi-Fi password"
    default ""
    help
        WPA/WPA2/WPA3 password. Leave empty only for an open test network.

config FACTORY_DEVICE_ID
    string "Timer device ID"
    default "ESP01"
    help
        Uppercase protocol identifier. For the fleet test use ESP01 through ESP05.
        The protocol supports extending the same naming convention through ESP15.

config FACTORY_DEBUG_LOGS
    bool "Enable verbose factory timer protocol logs"
    default n
    help
        Compile detailed FCT1 packet, peer, acknowledgement, duplicate, and
        heartbeat logging into the firmware. Leave disabled for normal use.

config FACTORY_START_EDGE_DIAGNOSTICS
    bool "Enable physical START-edge diagnostic GPIO"
    default y
    help
        Drives a GPIO high at the real scheduler START transition and low when
        the timer is re-armed/reset. Use only for timing validation.

config FACTORY_START_EDGE_GPIO
    int "Physical START-edge diagnostic GPIO"
    range 0 48
    default 21
    depends on FACTORY_START_EDGE_DIAGNOSTICS
    help
        GPIO connected to the external/ESP32 logic analyzer. GPIO21 is safe
        for the current timer-only ESP32 and ESP32-S3 test firmware.

endmenu
